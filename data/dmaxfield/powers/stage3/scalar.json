        "start_value": 40
    },

    "scale_up":
    {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": 
            [
                {
                    "type": "origins:change_resource",
                    "resource": "dmaxfield:stage3/scalar_value",
                    "change": 1
                },
                {
                    "type": "origins:execute_command",
                    "command": "scale multiply pehkui:base 1.118 @s"
                }
            ]
        },
        "condition": 
        {
            "type": "origins:and",
            "conditions": 
            [
                {
                    "type": "origins:resource",
                    "resource": "dmaxfield:stage3/scalar_value",
                    "comparison": "<",
                    "compare_to": 65
                },
                {
                    "type": "origins:and",
                    "conditions":
                    [
                        {
                            "type": "origins:in_rain"
                        },
                        {
                            "type": "origins:biome",
                            "condition": {
                                "type": "origins:temperature",
                                "comparison": "<",
                                "compare_to": 0.15
                            }
                        }
                    ],

                    "inverted": true
                },
                {
                    "type": "origins:riding",
                    "inverted": true
                }
            ]
        },
        "cooldown": 2,

        "key": {
            "key": "key.origins.primary_active",
            "continuous": true
        }
    },

    "scale_down":
    {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": 
            [
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:sneaking"
                    },
                    "if_action": {
                        "type": "origins:change_resource",
                        "resource": "dmaxfield:stage3/scalar_value",
                        "change": -2
                    },
                    "else_action": {
                        "type": "origins:change_resource",
                        "resource": "dmaxfield:stage3/scalar_value",
                        "change": -1
                    }
                },
                {
                    "type": "origins:execute_command",
                    "command": "scale divide pehkui:base 1.118 @s"
                }
            ]
        },
        "condition": 
        {
            "type": "origins:and",
            "conditions": 
            [
                {
                    "type": "origins:resource",
                    "resource": "dmaxfield:stage3/scalar_value",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:and",
                    "conditions":
                    [
                        {
                            "type": "origins:in_rain"
                        },
                        {
                            "type": "origins:biome",
                            "condition": {
                                "type": "origins:temperature",
                                "comparison": "<",
                                "compare_to": 0.15
                            }
                        }
                    ],

                    "inverted": true
                },
                {
                    "type": "origins:riding",
                    "inverted": true
                }
            ]
            
        },
        "cooldown": 2,

        "key": {
            "key": "key.origins.secondary_active",
            "continuous": true
        }
    },

    "reach_motion_fix":
    {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:if_else",
            "condition": 
            {
                "type": "origins:command",
                "command": "scale get pehkui:base @s",
                "comparison": "<",
                "compare_to": 1
            },
            "if_action": {
                "type": "origins:and",
                "actions":
                [
                    {
                        "type": "origins:execute_command",
                        "command": "scale modifier add pehkui:reach pehkui:base_divisor"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "scale modifier add pehkui:motion pehkui:base_divisor"
                    }
                ]
            },
            "else_action": 
            {
                "type": "origins:and",
                "actions":
                [
                    {
                        "type": "origins:execute_command",
                        "command": "scale modifier remove pehkui:reach pehkui:base_divisor"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "scale modifier remove pehkui:motion pehkui:base_divisor"
                    }
                ]
            }
        },
        "interval": 20
    },

    "scale_catch":
    {
        "type": "origins:action_over_time",
        "entity_action": 
        {
            "type": "origins:execute_command",
            "command": "scale set pehkui:base 1.0"
        },
        "condition":
        {
            "type": "origins:resource",
            "resource": "dmaxfield:stage3/scalar_value",
            "comparison": "==",
            "compare_to": 40
        },
        "interval": 20
    }
}